{
  "name": "cyberrange",
  "version": "1.0.0",
  "description": "Cyberrange infrastructure on Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "build:client": "vite build",
    "build": "npm run build:client",
    "dev": "npm run build:client && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240806.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vite-tsconfig-paths": "^4.3.0",
    "vitest": "^2.0.0",
    "wrangler": "^3.78.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "just-bash": "^3.4.2"
  }
}
